<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. The vehicle inspector (long-press the title) explores every public
  Vehicle SDK domain, so it needs the remaining public permissions. Release builds keep
  only what a rest session uses, declared in src/main/AndroidManifest.xml.
-->
